# DATABASE_URL — async PostgreSQL connection string (PostGIS enabled)
# Format: postgresql://user:password@host:port/dbname
# asyncpg uses: postgresql://... (no +asyncpg dialect prefix needed)
DATABASE_URL=postgresql://crisis_user:crisis_password@localhost:5433/crisis_care

# JWT_SECRET — must match the value in backend/gateway/.env
# (routing service never issues JWTs, but may validate them in future)
JWT_SECRET=replace_with_a_secure_random_string

# MAPBOX_API_KEY — your Mapbox secret token (sk.*)
# Used by the routing service to call the Directions API server-side
MAPBOX_API_KEY=sk.your_mapbox_secret_token_here

# PORT — port the FastAPI service listens on (default: 8000)
PORT=8000
