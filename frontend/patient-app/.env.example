# VITE_MAPBOX_TOKEN — your Mapbox public token (pk.*)
# Obtain from: https://account.mapbox.com/access-tokens/
# This is safe to expose client-side (Mapbox public token, not secret).
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# VITE_ROUTING_SERVICE_URL — base URL of the FastAPI routing service
VITE_ROUTING_SERVICE_URL=http://localhost:8000
