# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
FRONTEND_URL=http://localhost:3000
# Set to true when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=false

# --- Database (PostgreSQL + PostGIS) ---
# Matches docker-compose.yml at the repo root; adjust if you use your own server.
DATABASE_URL=postgresql://crisis:crisis_dev_password@localhost:5432/crisis_care

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# --- Seed data (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@crisiscare.local
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_CREW_PASSWORD=change-me-crew-password
# Hospital logins come from data/hospital_admin_credentials.csv (development only).
# In production they are skipped unless SEED_ALLOW_DEMO_CREDENTIALS=true.

# --- Dispatch tuning (optional) ---
# DISPATCH_RADIUS_KM=60
# HOSPITAL_SEARCH_RADIUS_KM=80
# AVG_SPEED_KMH=30
# EMERGENCY_RATE_LIMIT=15
# GPS_STALE_MINUTES=5
