# DATABASE_URL — PostgreSQL connection string (PostGIS enabled)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://crisis_user:crisis_password@localhost:5433/crisis_care

# JWT_SECRET — random, long string used to sign admin JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string

# MAPBOX_API_KEY — your Mapbox public/secret token
# Obtain from: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=pk.eyJ1IjoiYW1hYW4tc2lkZGlxdWUiLCJhIjoiY21zN2l1M2owMDRiYTMwcXlsc2x1NjZycyJ9.t42Kpdim7rL_GancFPjE2A

# PORT — port the Express gateway listens on (default: 4000)
PORT=4000

# CORS_ORIGINS — comma-separated admin/patient dev server origins
CORS_ORIGINS=http://localhost:5174,http://localhost:3000
