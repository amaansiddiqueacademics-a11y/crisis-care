# DATABASE_URL — PostgreSQL connection string (PostGIS enabled)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://crisis_user:crisis_password@localhost:5432/crisis_care

# JWT_SECRET — random, long string used to sign admin JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string

# MAPBOX_API_KEY — your Mapbox public/secret token
# Obtain from: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=pk.your_mapbox_token_here

# PORT — port the Express gateway listens on (default: 4000)
PORT=4000
