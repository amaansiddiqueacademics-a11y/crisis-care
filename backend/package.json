{
  "name": "crisis-care-backend",
  "version": "1.0.0",
  "description": "Backend API for Crisis Care emergency coordination platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/initDatabase.js",
    "db:seed": "node src/scripts/seedDatabase.js",
    "db:setup": "npm run db:init && npm run db:seed",
    "db:demo": "node src/scripts/seedDemo.js",
    "test": "node --test --test-concurrency=1 test/flow.test.js"
  },
  "keywords": [
    "crisis-care",
    "emergency",
    "ambulance",
    "hospital"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  }
}
