import React, { useState, useEffect, useCallback, useRef } from 'react';
import {
  ShieldCheck,
  History,
  Server,
  Activity,
  Database,
  CheckCircle2,
  Search,
  Filter,
  FileSpreadsheet,
  Lock,
  KeyRound,
  UserCheck,
  LogOut,
  AlertTriangle,
  Truck,
  MapPin,
  Radio,
  RefreshCw,
  Wifi,
  Users,
  ChevronDown,
  X,
} from 'lucide-react';
import {
  MapContainer,
  TileLayer,
  Marker,
  Popup,
  useMap,
} from 'react-leaflet';
import L from 'leaflet';
import { useCrisisCare } from '../../context/CrisisCareContext';

// ── Fix Leaflet default icons ─────────────────────────────────────────────────
delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
  iconUrl:       'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
  shadowUrl:     'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
});

// ── Attendant map marker by status ────────────────────────────────────────────
const createAttendantIcon = (status = 'available') => {
  const colors = {
    responding: { bg: '#ef4444', glow: 'rgba(239,68,68,0.7)', border: '#fff', label: '🚨' },
    available:  { bg: '#22c55e', glow: 'rgba(34,197,94,0.7)',  border: '#fff', label: '✓' },
    returning:  { bg: '#f59e0b', glow: 'rgba(245,158,11,0.7)', border: '#fff', label: '↩' },
  };
  const c = colors[status] || colors.available;
  return L.divIcon({
    className: '',
    html: `
      <div style="display:flex;flex-direction:column;align-items:center;">
        <div style="
          width:34px;height:34px;
          background:${c.bg};
          border:3px solid ${c.border};
          border-radius:50%;
          box-shadow:0 0 12px ${c.glow},0 2px 8px rgba(0,0,0,0.5);
          display:flex;align-items:center;justify-content:center;
          font-size:14px;font-weight:900;color:#fff;
        ">${c.label}</div>
        <div style="width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid ${c.bg};margin-top:-2px;"></div>
      </div>
    `,
    iconSize:    [34, 46],
    iconAnchor:  [17, 46],
    popupAnchor: [0, -48],
  });
};

// Auto-fit map to markers
function FitBounds({ attendants }) {
  const map = useMap();
  useEffect(() => {
    if (!attendants || attendants.length === 0) return;
    const bounds = L.latLngBounds(attendants.map(a => [a.lat, a.lng]));
    if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40] });
  }, [attendants.length]);
  return null;
}

// ── Resource type display names ───────────────────────────────────────────────
const RESOURCE_LABELS = {
  icu_bed:                     'ICU Bed',
  ventilator:                  'Ventilator',
  oxygen_cylinder:             'Oxygen Cylinder',
  specialist_trauma_surgeon:   'Trauma Surgeon',
  specialist_cardiologist:     'Cardiologist',
  specialist_neurologist:      'Neurologist',
  specialist_orthopaedic:      'Orthopaedic',
  specialist_anaesthesiologist:'Anaesthesiologist',
  equipment_ct_scanner:        'CT Scanner',
  equipment_mri_machine:       'MRI Machine',
  equipment_defibrillator:     'Defibrillator',
  blood_o_negative:            'Blood O−',
  blood_a_positive:            'Blood A+',
  blood_b_positive:            'Blood B+',
  blood_ab_positive:           'Blood AB+',
  general_bed:                 'General Bed',
  dialysis_machine:            'Dialysis Machine',
  neonatal_icu_bed:            'NICU Bed',
};

const ALL_RESOURCE_TYPES = Object.keys(RESOURCE_LABELS);

// Status badge config
const STATUS_BADGE = {
  responding: { label: 'Responding', cls: 'bg-red-500/20 text-red-300 border border-red-500/40' },
  available:  { label: 'Available',  cls: 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' },
  returning:  { label: 'Returning',  cls: 'bg-amber-500/20 text-amber-300 border border-amber-500/40' },
};

// ── Ambulance Live Map Panel ──────────────────────────────────────────────────
const AttendantMapPanel = ({ attendants, loading, onRefresh }) => {
  const [selectedAttendant, setSelectedAttendant] = useState(null);

  return (
    <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] overflow-hidden">
      {/* Header */}
      <div className="p-5 border-b border-[rgba(255,255,255,0.07)] flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 className="font-black text-base sm:text-lg flex items-center gap-2 text-white">
            <Truck className="w-5 h-5 text-amber-400" />
            Live Ambulance Attendants
          </h3>
          <p className="text-xs text-[rgba(255,255,255,0.4)]">
            Real-time location of all active paramedics
          </p>
        </div>
        <div className="flex items-center gap-2">
          <span className="flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
            {attendants.length} Active
          </span>
          <button
            onClick={onRefresh}
            disabled={loading}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[rgba(255,255,255,0.05)] hover:bg-[rgba(255,255,255,0.1)] border border-[rgba(255,255,255,0.1)] text-xs font-semibold text-white transition disabled:opacity-50"
          >
            <RefreshCw className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : ''}`} />
            Refresh
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3">
        {/* Attendant list */}
        <div className="lg:col-span-1 border-r border-[rgba(255,255,255,0.07)] max-h-[500px] overflow-y-auto">
          {loading && attendants.length === 0 ? (
            <div className="flex items-center justify-center py-16 text-xs text-[rgba(255,255,255,0.4)]">
              <RefreshCw className="w-4 h-4 animate-spin mr-2" /> Loading attendants…
            </div>
          ) : attendants.length === 0 ? (
            <div className="py-16 text-center text-xs text-[rgba(255,255,255,0.35)]">
              No attendants found in database.
            </div>
          ) : (
            attendants.map(a => {
              const s = STATUS_BADGE[a.status] || STATUS_BADGE.available;
              const isSelected = selectedAttendant?.badge_id === a.badge_id;
              return (
                <button
                  key={a.badge_id}
                  onClick={() => setSelectedAttendant(isSelected ? null : a)}
                  className={`w-full text-left p-4 border-b border-[rgba(255,255,255,0.05)] transition hover:bg-[rgba(255,255,255,0.04)] ${isSelected ? 'bg-amber-900/10' : ''}`}
                >
                  <div className="flex items-center gap-3">
                    <div className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 text-sm font-black
                      ${a.status === 'responding' ? 'bg-red-900/40 text-red-300 border border-red-700/50'
                      : a.status === 'available'  ? 'bg-emerald-900/40 text-emerald-300 border border-emerald-700/50'
                      :                             'bg-amber-900/40 text-amber-300 border border-amber-700/50'}`}>
                      {a.status === 'responding' ? '🚨' : a.status === 'available' ? '✓' : '↩'}
                    </div>
                    <div className="min-w-0">
                      <div className="text-xs font-bold text-white truncate">{a.name}</div>
                      <div className="text-[10px] font-mono text-[rgba(255,255,255,0.4)]">{a.badge_id}</div>
                      <div className="text-[10px] text-[rgba(255,255,255,0.35)]">{a.callsign}</div>
                    </div>
                    <span className={`ml-auto shrink-0 text-[10px] font-bold px-2 py-0.5 rounded-full ${s.cls}`}>
                      {s.label}
                    </span>
                  </div>
                  {a.email && (
                    <div className="mt-1.5 ml-12 text-[10px] text-[rgba(255,255,255,0.3)] truncate">{a.email}</div>
                  )}
                </button>
              );
            })
          )}
        </div>

        {/* Map */}
        <div className="lg:col-span-2" style={{ height: '500px' }}>
          {attendants.length > 0 ? (
            <MapContainer
              center={[19.076, 72.8777]}
              zoom={12}
              scrollWheelZoom
              style={{ width: '100%', height: '100%' }}
              zoomControl={false}
            >
              <FitBounds attendants={attendants} />
              <TileLayer
                attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
                subdomains="abc"
                maxZoom={19}
              />
              {attendants.map(a => (
                <Marker
                  key={a.badge_id}
                  position={[a.lat, a.lng]}
                  icon={createAttendantIcon(a.status)}
                  eventHandlers={{ click: () => setSelectedAttendant(a) }}
                >
                  <Popup>
                    <div style={{ fontFamily: 'system-ui, sans-serif', minWidth: 160 }}>
                      <strong style={{ color: '#1D1D1F', display: 'block', marginBottom: 4 }}>{a.name}</strong>
                      <span style={{ fontSize: 11, color: '#555', display: 'block' }}>{a.callsign}</span>
                      <span style={{ fontSize: 11, color: '#555', display: 'block' }}>ID: {a.badge_id}</span>
                      {a.email && <span style={{ fontSize: 10, color: '#888', display: 'block' }}>{a.email}</span>}
                      <span style={{
                        display: 'inline-block', marginTop: 6, padding: '2px 8px', borderRadius: 20,
                        fontSize: 10, fontWeight: 700,
                        background: a.status === 'responding' ? '#fee2e2' : a.status === 'available' ? '#dcfce7' : '#fef3c7',
                        color: a.status === 'responding' ? '#dc2626' : a.status === 'available' ? '#16a34a' : '#d97706',
                      }}>
                        {STATUS_BADGE[a.status]?.label || a.status}
                      </span>
                    </div>
                  </Popup>
                </Marker>
              ))}
            </MapContainer>
          ) : (
            <div className="flex flex-col items-center justify-center h-full gap-3 bg-[rgba(255,255,255,0.01)]">
              <MapPin className="w-8 h-8 text-[rgba(255,255,255,0.15)]" />
              <p className="text-xs text-[rgba(255,255,255,0.3)]">Attendant GPS data will appear here</p>
            </div>
          )}
        </div>
      </div>

      {/* Legend */}
      <div className="px-4 py-2.5 border-t border-[rgba(255,255,255,0.07)] flex flex-wrap items-center gap-4 text-[11px] text-[rgba(255,255,255,0.5)]">
        {Object.entries(STATUS_BADGE).map(([key, val]) => (
          <span key={key} className="flex items-center gap-1.5">
            <span className={`inline-block w-2 h-2 rounded-full ${
              key === 'responding' ? 'bg-red-500' : key === 'available' ? 'bg-emerald-500' : 'bg-amber-500'
            }`} />
            {val.label}
          </span>
        ))}
        <span className="ml-auto">Auto-refresh every 30s</span>
      </div>
    </div>
  );
};

// ── Resource Changes Table ────────────────────────────────────────────────────
const ResourceChangesTable = ({
  hospitals, resourceChanges, resourceChangesLoading,
  fetchAdminResourceChanges,
}) => {
  const [searchTerm, setSearchTerm]         = useState('');
  const [hospitalFilter, setHospitalFilter] = useState('ALL');
  const [resourceFilter, setResourceFilter] = useState('ALL');

  // Fetch when filters change
  useEffect(() => {
    fetchAdminResourceChanges({
      resource_type: resourceFilter !== 'ALL' ? resourceFilter : undefined,
      hospital_id:   hospitalFilter !== 'ALL' ? hospitalFilter  : undefined,
    });
  }, [hospitalFilter, resourceFilter]);

  // Client-side text search on top of server-filtered results
  const filtered = (resourceChanges || []).filter(row => {
    if (!searchTerm) return true;
    const q = searchTerm.toLowerCase();
    return (
      (row.hospital_name || '').toLowerCase().includes(q) ||
      (row.resource_type || '').toLowerCase().includes(q) ||
      String(row.quantity_available).includes(q)
    );
  });

  // ── CSV export ──────────────────────────────────────────────────────────────
  const exportCSV = useCallback(() => {
    const headers = ['Hospital', 'Resource Type', 'Quantity Available', 'Last Updated', 'Hospital ID'];
    const rows = filtered.map(r => [
      `"${r.hospital_name}"`,
      `"${RESOURCE_LABELS[r.resource_type] || r.resource_type}"`,
      r.quantity_available,
      `"${r.last_updated_at ? new Date(r.last_updated_at).toLocaleString() : ''}"`,
      r.hospital_id,
    ]);
    const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = `crisis-care-resources-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }, [filtered]);

  return (
    <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] overflow-hidden">
      {/* Header */}
      <div className="p-5 border-b border-[rgba(255,255,255,0.07)]">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h3 className="font-black text-base sm:text-lg flex items-center gap-2 text-white">
              <History className="w-5 h-5 text-indigo-400" />
              Live Hospital Resource Status
            </h3>
            <p className="text-xs text-[rgba(255,255,255,0.4)]">
              Latest quantities across all hospitals — updated in real-time via SSE
            </p>
          </div>
          <button
            onClick={exportCSV}
            className="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-indigo-900/30 hover:bg-indigo-800/50 border border-indigo-700/40 text-xs font-bold text-indigo-300 hover:text-white transition"
          >
            <FileSpreadsheet className="w-4 h-4" />
            Export CSV
          </button>
        </div>

        {/* Filters row */}
        <div className="flex flex-wrap items-center gap-3 mt-4">
          {/* Text search */}
          <div className="relative">
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" />
            <input
              type="text"
              value={searchTerm}
              onChange={e => setSearchTerm(e.target.value)}
              placeholder="Search hospital, resource…"
              style={{ color: '#0f172a', backgroundColor: '#ffffff', WebkitTextFillColor: '#0f172a' }}
              className="pl-8 pr-3 py-1.5 text-xs font-bold rounded-lg border border-slate-300 outline-none focus:border-indigo-500 w-52 shadow-xs"
            />
          </div>

          {/* Hospital filter */}
          <select
            value={hospitalFilter}
            onChange={e => setHospitalFilter(e.target.value)}
            style={{ color: '#0f172a', backgroundColor: '#ffffff', WebkitTextFillColor: '#0f172a' }}
            className="text-xs font-bold border border-slate-300 rounded-lg px-2.5 py-1.5 outline-none focus:border-indigo-500 shadow-xs max-w-[200px]"
          >
            <option value="ALL" style={{ color: '#0f172a' }}>All Hospitals</option>
            {hospitals.map(h => (
              <option key={h.id} value={h.id} style={{ color: '#0f172a' }}>{h.name}</option>
            ))}
          </select>

          {/* Resource type filter */}
          <select
            value={resourceFilter}
            onChange={e => setResourceFilter(e.target.value)}
            style={{ color: '#0f172a', backgroundColor: '#ffffff', WebkitTextFillColor: '#0f172a' }}
            className="text-xs font-bold border border-slate-300 rounded-lg px-2.5 py-1.5 outline-none focus:border-indigo-500 shadow-xs"
          >
            <option value="ALL" style={{ color: '#0f172a' }}>All Resource Types</option>
            <optgroup label="── Beds">
              <option value="icu_bed">ICU Bed</option>
              <option value="neonatal_icu_bed">NICU Bed</option>
              <option value="general_bed">General Bed</option>
            </optgroup>
            <optgroup label="── Equipment">
              <option value="ventilator">Ventilator</option>
              <option value="oxygen_cylinder">Oxygen Cylinder</option>
              <option value="equipment_ct_scanner">CT Scanner</option>
              <option value="equipment_mri_machine">MRI Machine</option>
              <option value="equipment_defibrillator">Defibrillator</option>
              <option value="dialysis_machine">Dialysis Machine</option>
            </optgroup>
            <optgroup label="── Doctors">
              <option value="specialist_trauma_surgeon">Trauma Surgeon</option>
              <option value="specialist_cardiologist">Cardiologist</option>
              <option value="specialist_neurologist">Neurologist</option>
              <option value="specialist_orthopaedic">Orthopaedic</option>
              <option value="specialist_anaesthesiologist">Anaesthesiologist</option>
            </optgroup>
            <optgroup label="── Blood">
              <option value="blood_o_negative">Blood O−</option>
              <option value="blood_a_positive">Blood A+</option>
              <option value="blood_b_positive">Blood B+</option>
              <option value="blood_ab_positive">Blood AB+</option>
            </optgroup>
          </select>

          {resourceChangesLoading && (
            <RefreshCw className="w-4 h-4 animate-spin text-indigo-400" />
          )}
        </div>
      </div>

      {/* Table */}
      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead className="border-b font-bold uppercase tracking-wider text-[11px] bg-[rgba(255,255,255,0.02)] border-[rgba(255,255,255,0.07)] text-[rgba(255,255,255,0.5)]">
            <tr>
              <th className="py-3 px-4">Hospital</th>
              <th className="py-3 px-4">Resource Type</th>
              <th className="py-3 px-4 text-center">Qty Available</th>
              <th className="py-3 px-4">Last Updated</th>
              <th className="py-3 px-4">Status</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-[rgba(255,255,255,0.05)]">
            {resourceChangesLoading && filtered.length === 0 ? (
              <tr>
                <td colSpan={5} className="py-10 text-center">
                  <RefreshCw className="w-5 h-5 animate-spin text-indigo-400 mx-auto" />
                </td>
              </tr>
            ) : filtered.length === 0 ? (
              <tr>
                <td colSpan={5} className="py-8 text-center text-[rgba(255,255,255,0.4)] font-semibold">
                  No matching records found.
                </td>
              </tr>
            ) : (
              filtered.map((row, idx) => {
                const qty = row.quantity_available;
                const isCritical = qty === 0;
                const isLow      = qty > 0 && qty <= 3;
                const updatedAt  = row.last_updated_at ? new Date(row.last_updated_at) : null;
                const minutesAgo = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 60000) : null;
                const isStale    = minutesAgo !== null && minutesAgo > (row.staleness_threshold_minutes || 60);

                return (
                  <tr key={`${row.resource_id}-${idx}`} className="transition hover:bg-[rgba(255,255,255,0.02)]">
                    <td className="py-3 px-4 font-semibold text-white max-w-[200px] truncate">
                      {row.hospital_name}
                    </td>
                    <td className="py-3 px-4 text-[rgba(255,255,255,0.8)]">
                      {RESOURCE_LABELS[row.resource_type] || row.resource_type}
                    </td>
                    <td className="py-3 px-4 text-center">
                      <span className={`inline-flex items-center justify-center min-w-[2rem] px-2 py-0.5 rounded-full font-black text-sm
                        ${isCritical ? 'bg-red-500/20 text-red-300 border border-red-500/40'
                        : isLow      ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                        :              'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'}`}>
                        {qty}
                      </span>
                    </td>
                    <td className="py-3 px-4 text-[rgba(255,255,255,0.55)] whitespace-nowrap">
                      {updatedAt ? (
                        <>
                          <div>{updatedAt.toLocaleTimeString()}</div>
                          <div className="text-[10px] text-[rgba(255,255,255,0.3)]">
                            {minutesAgo != null ? (minutesAgo < 1 ? 'Just now' : `${minutesAgo}m ago`) : ''}
                          </div>
                        </>
                      ) : '—'}
                    </td>
                    <td className="py-3 px-4">
                      {isCritical ? (
                        <span className="badge text-[10px] bg-red-900/30 text-red-300 border border-red-700/40">
                          <AlertTriangle className="w-2.5 h-2.5 mr-0.5" />
                          Critical
                        </span>
                      ) : isStale ? (
                        <span className="badge text-[10px] bg-amber-900/30 text-amber-300 border border-amber-700/40">
                          Stale
                        </span>
                      ) : (
                        <span className="badge text-[10px] bg-emerald-900/30 text-emerald-300 border border-emerald-700/40">
                          <CheckCircle2 className="w-2.5 h-2.5 mr-0.5" />
                          Live
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      {/* Footer */}
      <div className="p-3 border-t flex items-center justify-between text-[11px] px-4 bg-[rgba(255,255,255,0.01)] border-[rgba(255,255,255,0.07)] text-[rgba(255,255,255,0.5)]">
        <span className="font-medium">
          Showing {filtered.length} of {(resourceChanges || []).length} records
        </span>
        <button
          onClick={exportCSV}
          className="flex items-center gap-1 font-bold text-indigo-400 hover:text-indigo-300 transition"
        >
          <FileSpreadsheet className="w-3.5 h-3.5" />
          Download CSV
        </button>
      </div>
    </div>
  );
};

// ── Admin Login Screen ────────────────────────────────────────────────────────
const AdminLogin = ({ loginAdmin }) => {
  const [adminIdInput, setAdminIdInput] = useState('adm_shivam_027');
  const [passwordInput, setPasswordInput] = useState('admin123');
  const [showPassword, setShowPassword] = useState(false);

  return (
    <div className="max-w-md mx-auto py-8 animate-fade-in">
      <div className="glass-dark rounded-3xl border border-[rgba(255,255,255,0.1)] p-6 sm:p-8 shadow-[0_8px_40px_rgba(0,0,0,0.6)] space-y-6">
        <div className="text-center">
          <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-700 to-indigo-900 flex items-center justify-center mx-auto mb-3 shadow-[0_0_20px_rgba(99,102,241,0.3)]">
            <ShieldCheck className="w-7 h-7 text-white" />
          </div>
          <h1 className="text-2xl font-black text-white">Admin Operations Login</h1>
          <p className="text-xs text-[rgba(255,255,255,0.4)] mt-1">Control panel for system managers only</p>
        </div>

        <form onSubmit={e => { e.preventDefault(); loginAdmin(adminIdInput, passwordInput); }} className="space-y-4">
          <div>
            <label className="block text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider mb-1.5">
              Admin Username
            </label>
            <div className="relative">
              <UserCheck className="w-3.5 h-3.5 text-[rgba(255,255,255,0.3)] absolute left-3.5 top-3" />
              <input
                type="text"
                value={adminIdInput}
                onChange={e => setAdminIdInput(e.target.value)}
                style={{ color: '#fff', WebkitTextFillColor: '#fff' }}
                className="w-full pl-9 pr-3 py-2.5 text-xs font-bold rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.06)] text-white outline-none focus:border-indigo-600/60"
                placeholder="adm_shivam_027"
                required
              />
            </div>
          </div>

          <div>
            <label className="block text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider mb-1.5">
              Admin Master Password
            </label>
            <div className="relative">
              <KeyRound className="w-3.5 h-3.5 text-[rgba(255,255,255,0.3)] absolute left-3.5 top-3" />
              <input
                type={showPassword ? 'text' : 'password'}
                value={passwordInput}
                onChange={e => setPasswordInput(e.target.value)}
                style={{ color: '#fff', WebkitTextFillColor: '#fff' }}
                className="w-full pl-9 pr-16 py-2.5 text-xs font-bold rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.06)] text-white outline-none focus:border-indigo-600/60"
                placeholder="••••••••••"
                required
              />
              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                className="absolute right-3 top-2.5 text-[11px] font-bold text-indigo-400 hover:text-indigo-300 transition"
              >
                {showPassword ? 'Hide' : 'Show'}
              </button>
            </div>
          </div>

          <div className="flex items-center gap-2 p-2.5 rounded-lg border border-[rgba(255,255,255,0.07)] bg-[rgba(255,255,255,0.03)] text-[11px] text-[rgba(255,255,255,0.4)]">
            <Lock className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
            <span>Demo: <strong className="text-white font-mono">adm_shivam_027</strong> / <strong className="text-white font-mono">admin123</strong></span>
          </div>

          <button type="submit" className="w-full text-white font-black text-xs py-3 rounded-xl transition bg-indigo-700 hover:bg-indigo-600">
            LOGIN TO ADMIN PANEL
          </button>
        </form>

        <div className="pt-3 border-t border-[rgba(255,255,255,0.07)] space-y-2">
          <span className="text-[11px] font-bold text-[rgba(255,255,255,0.3)] block text-center">Fast Demo Authentication:</span>
          <button
            type="button"
            onClick={() => loginAdmin('adm_shivam_027', 'admin123')}
            className="w-full text-[11px] font-bold text-indigo-300 hover:text-white bg-indigo-950/40 hover:bg-indigo-900/50 py-2.5 px-3 rounded-xl border border-indigo-800/40 transition flex items-center justify-center gap-2"
          >
            <ShieldCheck className="w-4 h-4" />
            <span>⚡ 1-Click: Super Admin (Shivam Mishra)</span>
          </button>
        </div>
      </div>
    </div>
  );
};

// ── Tab nav ───────────────────────────────────────────────────────────────────
const TABS = [
  { id: 'resources', label: 'Resource Monitor',    icon: Database },
  { id: 'attendants', label: 'Live Ambulances',    icon: Truck },
  { id: 'audit',      label: 'Change History',     icon: History },
];

// ── Main AdminPortal ──────────────────────────────────────────────────────────
export const AdminPortal = () => {
  const {
    adminAuth,
    loginAdmin,
    logoutAdmin,
    auditLogs,
    hospitals,
    showToast,
    liveAttendants,
    attendantsLoading,
    resourceChanges,
    resourceChangesLoading,
    fetchAdminResourceChanges,
    fetchLiveAttendants,
  } = useCrisisCare();

  const [activeTab, setActiveTab] = useState('resources');

  // Audit log local filters (legacy mock data)
  const [auditSearch, setAuditSearch]             = useState('');
  const [auditHospitalFilter, setAuditHospital]   = useState('ALL');

  // Auto-load data on admin login
  useEffect(() => {
    if (!adminAuth) return;
    fetchAdminResourceChanges({});
    fetchLiveAttendants();
  }, [adminAuth]);

  // Auto-refresh attendants every 30s
  useEffect(() => {
    if (!adminAuth) return;
    const interval = setInterval(fetchLiveAttendants, 30000);
    return () => clearInterval(interval);
  }, [adminAuth]);

  if (!adminAuth) {
    return <AdminLogin loginAdmin={loginAdmin} />;
  }

  // Filtered audit logs (legacy)
  const filteredAuditLogs = auditLogs.filter(log => {
    const matchesSearch =
      log.action.toLowerCase().includes(auditSearch.toLowerCase()) ||
      log.adminName.toLowerCase().includes(auditSearch.toLowerCase()) ||
      log.resourceType.toLowerCase().includes(auditSearch.toLowerCase()) ||
      log.hospitalName.toLowerCase().includes(auditSearch.toLowerCase());
    const matchesHosp = auditHospitalFilter === 'ALL' || String(log.hospitalId) === String(auditHospitalFilter);
    return matchesSearch && matchesHosp;
  });

  const exportAuditCSV = () => {
    const headers = ['Log ID', 'Timestamp', 'Date', 'Hospital', 'Admin', 'Resource', 'Before', 'After', 'Action'];
    const rows = filteredAuditLogs.map(l => [
      l.id, l.timestamp, l.date, `"${l.hospitalName}"`, `"${l.adminName}"`,
      `"${l.resourceType}"`, l.previousQty, l.newQty, `"${l.action}"`,
    ]);
    const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `crisis-care-audit-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="space-y-6 animate-fade-in">
      {/* ── Banner ──────────────────────────────────────────────────────────── */}
      <div className="glass-dark border border-indigo-900/40 rounded-3xl p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center gap-3.5">
          <div className="w-12 h-12 rounded-2xl bg-indigo-900/40 border border-indigo-800/40 flex items-center justify-center">
            <ShieldCheck className="w-6 h-6 text-indigo-400" />
          </div>
          <div>
            <div className="flex items-center gap-2 mb-0.5">
              <span className="badge border border-indigo-800/40 bg-indigo-900/30 text-indigo-300">Admin Panel</span>
            </div>
            <h1 className="text-lg sm:text-xl font-black text-white">Admin Control Centre</h1>
            <p className="text-xs text-[rgba(255,255,255,0.4)]">
              Logged in as <strong className="text-white">{adminAuth.name}</strong> ({adminAuth.adminId})
            </p>
          </div>
        </div>

        <div className="flex items-center gap-3">
          <div className="glass-dark px-3 py-1.5 rounded-lg border border-[rgba(255,255,255,0.07)] text-xs flex items-center gap-2 text-white">
            <Server className="w-4 h-4 text-emerald-400" />
            <span>Database: <strong className="text-emerald-400">Connected</strong></span>
          </div>
          <button
            onClick={logoutAdmin}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-600/30 hover:bg-red-600 border border-red-500/50 text-xs font-bold text-red-200 hover:text-white transition"
          >
            <LogOut className="w-3.5 h-3.5" />
            <span>Log Out Admin</span>
          </button>
        </div>
      </div>

      {/* ── System metric cards ─────────────────────────────────────────────── */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] p-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider">System Uptime</span>
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
          </div>
          <div className="text-2xl font-black text-white mt-2">99.98%</div>
          <div className="text-[11px] text-[rgba(255,255,255,0.35)] mt-1">SLA target: &gt; 99.9% uptime</div>
        </div>
        <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] p-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider">Hospital Search Speed</span>
            <Database className="w-4 h-4 text-emerald-400" />
          </div>
          <div className="text-2xl font-black text-emerald-400 mt-2">28 ms</div>
          <div className="text-[11px] text-[rgba(255,255,255,0.35)] mt-1">Hospital search speed (target &lt; 500ms)</div>
        </div>
        <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] p-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider">Live Attendants</span>
            <Users className="w-4 h-4 text-amber-400" />
          </div>
          <div className="text-2xl font-black text-amber-400 mt-2">{liveAttendants.length}</div>
          <div className="text-[11px] text-[rgba(255,255,255,0.35)] mt-1">
            {liveAttendants.filter(a => a.status === 'responding').length} responding now
          </div>
        </div>
        <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] p-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-[rgba(255,255,255,0.5)] uppercase tracking-wider">Access Level</span>
            <Lock className="w-4 h-4 text-amber-400" />
          </div>
          <div className="text-2xl font-black text-amber-400 mt-2">Super</div>
          <div className="text-[11px] text-[rgba(255,255,255,0.35)] mt-1">Admin: {adminAuth.adminId}</div>
        </div>
      </div>

      {/* ── Tab bar ─────────────────────────────────────────────────────────── */}
      <div className="flex items-center gap-1 glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] p-1.5">
        {TABS.map(tab => {
          const Icon = tab.icon;
          const active = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition flex-1 justify-center
                ${active
                  ? 'bg-indigo-700 text-white shadow'
                  : 'text-[rgba(255,255,255,0.5)] hover:text-white hover:bg-[rgba(255,255,255,0.06)]'
                }`}
            >
              <Icon className="w-4 h-4" />
              {tab.label}
            </button>
          );
        })}
      </div>

      {/* ── Tab content ─────────────────────────────────────────────────────── */}

      {/* Live Resource Monitor */}
      {activeTab === 'resources' && (
        <ResourceChangesTable
          hospitals={hospitals}
          resourceChanges={resourceChanges}
          resourceChangesLoading={resourceChangesLoading}
          fetchAdminResourceChanges={fetchAdminResourceChanges}
        />
      )}

      {/* Live Ambulance Map */}
      {activeTab === 'attendants' && (
        <AttendantMapPanel
          attendants={liveAttendants}
          loading={attendantsLoading}
          onRefresh={fetchLiveAttendants}
        />
      )}

      {/* Change History (legacy audit log mock) */}
      {activeTab === 'audit' && (
        <div className="glass-dark rounded-2xl border border-[rgba(255,255,255,0.07)] overflow-hidden">
          <div className="p-5 border-b border-[rgba(255,255,255,0.07)] flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 className="font-black text-base sm:text-lg flex items-center gap-2 text-white">
                <History className="w-5 h-5 text-indigo-500" />
                Change History — Hospital Resources
              </h3>
              <p className="text-xs text-[rgba(255,255,255,0.4)]">
                Full history of all bed, oxygen, and equipment changes across hospitals
              </p>
            </div>
            <div className="flex items-center gap-3">
              <div className="relative">
                <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" />
                <input
                  type="text"
                  value={auditSearch}
                  onChange={e => setAuditSearch(e.target.value)}
                  placeholder="Filter logs by keyword..."
                  style={{ color: '#0f172a', backgroundColor: '#ffffff', WebkitTextFillColor: '#0f172a' }}
                  className="pl-8 pr-3 py-1.5 text-xs font-bold rounded-lg border border-slate-300 text-slate-900 bg-white outline-none focus:border-red-500 w-48 sm:w-60 shadow-xs"
                />
              </div>
              <select
                value={auditHospitalFilter}
                onChange={e => setAuditHospital(e.target.value)}
                style={{ color: '#0f172a', backgroundColor: '#ffffff', WebkitTextFillColor: '#0f172a' }}
                className="text-xs font-bold border border-slate-300 rounded-lg px-2.5 py-1.5 outline-none text-slate-900 bg-white focus:border-red-500 shadow-xs"
              >
                <option value="ALL" style={{ color: '#0f172a' }}>All Facilities</option>
                {hospitals.map(h => (
                  <option key={h.id} value={h.id} style={{ color: '#0f172a' }}>{h.name}</option>
                ))}
              </select>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="border-b font-bold uppercase tracking-wider text-[11px] bg-[rgba(255,255,255,0.02)] border-[rgba(255,255,255,0.07)] text-[rgba(255,255,255,0.5)]">
                <tr>
                  <th className="py-3 px-4">Log ID</th>
                  <th className="py-3 px-4">Timestamp</th>
                  <th className="py-3 px-4">Facility</th>
                  <th className="py-3 px-4">Administrator</th>
                  <th className="py-3 px-4">Resource Target</th>
                  <th className="py-3 px-4">Change (Before → After)</th>
                  <th className="py-3 px-4">Reason / System Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[rgba(255,255,255,0.05)]">
                {filteredAuditLogs.length === 0 ? (
                  <tr>
                    <td colSpan={7} className="py-8 text-center text-[rgba(255,255,255,0.4)] font-semibold">
                      No matching audit records found.
                    </td>
                  </tr>
                ) : (
                  filteredAuditLogs.map(log => (
                    <tr key={log.id} className="transition hover:bg-[rgba(255,255,255,0.02)]">
                      <td className="py-3 px-4 font-mono font-bold text-indigo-400">{log.id}</td>
                      <td className="py-3 px-4 whitespace-nowrap">
                        <div className="text-white font-medium">{log.timestamp}</div>
                        <div className="text-[10px] text-[rgba(255,255,255,0.4)]">{log.date}</div>
                      </td>
                      <td className="py-3 px-4 font-semibold text-white">{log.hospitalName}</td>
                      <td className="py-3 px-4">
                        <span className="font-semibold text-white">{log.adminName}</span>
                        <span className="block text-[10px] font-mono text-[rgba(255,255,255,0.4)]">{log.adminId}</span>
                      </td>
                      <td className="py-3 px-4 font-bold text-emerald-400">{log.resourceType}</td>
                      <td className="py-3 px-4 text-center">
                        <span className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full font-bold bg-[rgba(255,255,255,0.05)] text-white border border-[rgba(255,255,255,0.1)]">
                          <span className="line-through text-[rgba(255,255,255,0.4)]">{log.previousQty}</span>
                          <span>→</span>
                          <span className="text-emerald-400 font-black">{log.newQty}</span>
                        </span>
                      </td>
                      <td className="py-3 px-4 font-medium text-[rgba(255,255,255,0.8)]">{log.action}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          <div className="p-3 border-t flex items-center justify-between text-[11px] px-4 bg-[rgba(255,255,255,0.01)] border-[rgba(255,255,255,0.07)] text-[rgba(255,255,255,0.5)]">
            <span className="font-medium">Showing {filteredAuditLogs.length} change records</span>
            <button
              onClick={exportAuditCSV}
              className="flex items-center gap-1 font-bold text-indigo-400 hover:text-indigo-300 transition"
            >
              <FileSpreadsheet className="w-3.5 h-3.5" />
              Download Change History (CSV)
            </button>
          </div>
        </div>
      )}
    </div>
  );
};
